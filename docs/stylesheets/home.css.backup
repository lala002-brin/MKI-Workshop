
   MKI WORKSHOP HOME
   PART 1
   FOUNDATION
   ========================================================= */


/* ---------------------------------------------------------
   HOME VARIABLES
   --------------------------------------------------------- */

body:has(.home-hero) {
  --mki-blue: #2f73e6;
  --mki-blue-soft: #eaf3ff;

  --mki-navy: #203a57;
  --mki-navy-deep: #182f49;

  --mki-bg: #f3f7fb;
  --mki-bg-white: #ffffff;
  --mki-bg-blue: #eaf2fa;

  --mki-text: #172b45;
  --mki-muted: #63758c;

  --mki-border: #d9e4ef;

  --mki-container: 1160px;
}


/* ---------------------------------------------------------
   HOME ONLY
   --------------------------------------------------------- */

body:has(.home-hero) .md-main {
  background: var(--mki-bg);
}


/* ---------------------------------------------------------
   DO NOT DISTURB MATERIAL GRID
   --------------------------------------------------------- */

body:has(.home-hero) .md-grid {
  box-sizing: border-box;
}


/* ---------------------------------------------------------
   HOME CONTENT
   --------------------------------------------------------- */

body:has(.home-hero) .md-content {
  box-sizing: border-box;
}


/* ---------------------------------------------------------
   TYPOGRAPHY RESET
   --------------------------------------------------------- */

body:has(.home-hero) .md-typeset {
  color: var(--mki-text);
}


/* ---------------------------------------------------------
   HOME SECTION
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features,
body:has(.home-hero) .mki-workflow,
body:has(.home-hero) .mki-questions,
body:has(.home-hero) .mki-research,
body:has(.home-hero) .mki-roadmap,
body:has(.home-hero) .mki-contributor {
  width: 100%;
  box-sizing: border-box;
}


/* ---------------------------------------------------------
   INNER CONTAINERS
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {
  width: min(
    var(--mki-container),
    calc(100% - 48px)
  );

  max-width: var(--mki-container);

  margin-left: auto;
  margin-right: auto;

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   SECTION SPACING
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {
  padding-top: 76px;
  padding-bottom: 76px;
}


/* ---------------------------------------------------------
   REMOVE DEFAULT MARKDOWN SPACING
   --------------------------------------------------------- */

body:has(.home-hero) .md-typeset > section:first-child {
  margin-top: 0;
}


/* ---------------------------------------------------------
   SECTION HEADINGS
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features h2,
body:has(.home-hero) .mki-workflow h2,
body:has(.home-hero) .mki-questions h2,
body:has(.home-hero) .mki-research h2,
body:has(.home-hero) .mki-roadmap h2,
body:has(.home-hero) .mki-contributor h2 {
  margin-top: 18px;
  margin-bottom: 0;

  max-width: 820px;

  font-size: clamp(
    2rem,
    3.4vw,
    3rem
  );

  line-height: 1.1;

  letter-spacing: -.035em;

  font-weight: 800;
}


/* ---------------------------------------------------------
   SECTION DESCRIPTION
   --------------------------------------------------------- */

body:has(.home-hero) .mki-section-intro {
  max-width: 680px;

  margin-top: 16px;
  margin-bottom: 0;

  color: var(--mki-muted);

  font-size: .92rem;

  line-height: 1.7;
}
/* =========================================================
   PART 2
   HERO
   ========================================================= */


/* ---------------------------------------------------------
   HERO
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero {
  position: relative;

  width: 100%;

  min-height: 560px;

  display: flex;

  align-items: center;

  overflow: hidden;

  box-sizing: border-box;

  background:
    linear-gradient(
      135deg,
      #284965 0%,
      #315775 55%,
      #416982 100%
    );
}


/* ---------------------------------------------------------
   HERO BACKGROUND IMAGE
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero img {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;

  z-index: 0;
}


/* ---------------------------------------------------------
   HERO IMAGE OVERLAY
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero::before {
  content: "";

  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(22, 47, 71, .76),
      rgba(35, 67, 93, .56),
      rgba(54, 88, 112, .40)
    );
}


/* ---------------------------------------------------------
   HERO LIGHT
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero::after {
  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  right: -130px;
  top: -170px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(121, 190, 255, .24),
      transparent 68%
    );

  z-index: 2;

  pointer-events: none;
}


/* ---------------------------------------------------------
   HERO CONTENT
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero > .hero-content {
  position: relative;

  z-index: 3;

  width: min(
    var(--mki-container),
    calc(100% - 48px)
  );

  max-width: var(--mki-container);

  margin-left: auto;
  margin-right: auto;

  padding-top: 76px;
  padding-bottom: 76px;

  box-sizing: border-box;

  text-align: center;
}


/* ---------------------------------------------------------
   HERO LABEL
   --------------------------------------------------------- */

body:has(.home-hero) .hero-label {
  display: inline-flex;

  align-items: center;

  padding: 7px 14px;

  border: 1px solid rgba(255,255,255,.25);

  border-radius: 999px;

  background: rgba(255,255,255,.09);

  color: #e4f1ff;

  font-size: .66rem;

  font-weight: 800;

  letter-spacing: .14em;

  text-transform: uppercase;
}


/* ---------------------------------------------------------
   HERO TITLE
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero h1 {
  max-width: 900px;

  margin: 23px auto 0;

  color: #ffffff;

  font-size: clamp(
    2.8rem,
    5vw,
    4.4rem
  );

  line-height: 1.04;

  letter-spacing: -.05em;

  font-weight: 800;
}


/* ---------------------------------------------------------
   HERO TITLE ACCENT
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero h1::after {
  content: "";

  display: block;

  width: 42px;

  height: 3px;

  margin: 21px auto 0;

  border-radius: 999px;

  background: #73b3ff;
}


/* ---------------------------------------------------------
   HERO DESCRIPTION
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero p {
  max-width: 680px;

  margin: 20px auto 0;

  color: #d9e7f5;

  font-size: .96rem;

  line-height: 1.7;
}


/* ---------------------------------------------------------
   HERO BUTTONS
   --------------------------------------------------------- */

body:has(.home-hero) .hero-actions {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 10px;

  margin-top: 27px;
}


body:has(.home-hero) .hero-actions a {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 43px;

  padding: 0 19px;

  border-radius: 8px;

  font-size: .82rem;

  font-weight: 700;

  text-decoration: none;
}


body:has(.home-hero) .hero-actions a:first-child {
  background: var(--mki-blue);

  color: #ffffff;

  box-shadow:
    0 8px 20px rgba(20, 74, 160, .25);
}


body:has(.home-hero) .hero-actions a:last-child {
  border: 1px solid rgba(255,255,255,.28);

  background: rgba(255,255,255,.08);

  color: #ffffff;
}
/* =========================================================
   PART 3
   FEATURES
   ========================================================= */

body:has(.home-hero) .mki-features {
  background:
    radial-gradient(
      circle at 85% 10%,
      rgba(111,171,235,.14),
      transparent 28%
    ),
    var(--mki-bg);
}


/* ---------------------------------------------------------
   FEATURE GRID
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-top: 42px;
}


/* ---------------------------------------------------------
   FEATURE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature {
  min-height: 190px;

  padding: 25px;

  box-sizing: border-box;

  border: 1px solid var(--mki-border);

  border-radius: 14px;

  background: rgba(255,255,255,.82);

  box-shadow:
    0 8px 25px rgba(38,69,104,.045);

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


body:has(.home-hero) .mki-feature:hover {
  transform: translateY(-3px);

  box-shadow:
    0 14px 30px rgba(38,69,104,.09);
}


/* ---------------------------------------------------------
   FEATURE ICON
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature-icon {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 31px;
  height: 31px;

  margin-bottom: 18px;

  border: 1px solid #c8ddf4;

  border-radius: 8px;

  background: #edf5ff;

  color: var(--mki-blue);

  font-size: .7rem;
}


/* ---------------------------------------------------------
   FEATURE TITLE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature h3 {
  margin: 0;

  color: var(--mki-text);

  font-size: 1.05rem;

  line-height: 1.3;
}


/* ---------------------------------------------------------
   FEATURE TEXT
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature p {
  margin-top: 9px;

  color: var(--mki-muted);

  font-size: .82rem;

  line-height: 1.65;
}


/* ---------------------------------------------------------
   FEATURE TOOLS
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature-tools {
  margin-top: 14px;

  color: var(--mki-blue);

  font-size: .61rem;

  font-weight: 800;

  letter-spacing: .06em;
}
/* =========================================================
   PART 4
   WORKFLOW
   ========================================================= */

body:has(.home-hero) .mki-workflow {
  background:
    linear-gradient(
      135deg,
      #243f5d,
      #2b4c6a
    );

  color: #ffffff;
}


body:has(.home-hero) .mki-workflow h2 {
  color: #ffffff;
}


body:has(.home-hero) .mki-workflow .mki-section-intro {
  color: #c0d0e0;
}


/* ---------------------------------------------------------
   WORKFLOW PATH
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-path {
  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 12px;

  margin-top: 42px;
}


/* ---------------------------------------------------------
   WORKFLOW STEP
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-step {
  min-height: 180px;

  padding: 21px;

  border: 1px solid rgba(194,219,242,.15);

  border-radius: 13px;

  background: rgba(255,255,255,.055);

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   NUMBER
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-number {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 27px;
  height: 27px;

  margin-bottom: 18px;

  border: 1px solid rgba(104,173,255,.45);

  border-radius: 50%;

  color: #70b0ff;

  font-size: .62rem;

  font-weight: 800;
}


/* ---------------------------------------------------------
   STEP TITLE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-step h3 {
  margin: 0;

  color: #ffffff;

  font-size: .94rem;

  line-height: 1.3;
}


/* ---------------------------------------------------------
   STEP DESCRIPTION
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-step p {
  margin-top: 9px;

  color: #b6c8da;

  font-size: .76rem;

  line-height: 1.6;
}


/* ---------------------------------------------------------
   CONNECTOR
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-connector {
  display: none;
}
/* =========================================================
   PART 5
   RESEARCH CASES
   ========================================================= */

body:has(.home-hero) .mki-research {
  background:
    linear-gradient(
      135deg,
      #1b3049,
      #213d5a
    );

  color: #ffffff;
}


body:has(.home-hero) .mki-research h2 {
  color: #ffffff;
}


body:has(.home-hero) .mki-research .mki-section-intro {
  color: #c0d0e0;
}


/* ---------------------------------------------------------
   RESEARCH LIST
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-list {
  display: grid;

  gap: 15px;

  margin-top: 43px;
}


/* ---------------------------------------------------------
   RESEARCH CARD
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-case {
  display: grid;

  grid-template-columns:
    55px minmax(0, 1fr);

  min-height: 200px;

  overflow: hidden;

  border: 1px solid rgba(191,218,241,.14);

  border-radius: 14px;

  background: rgba(255,255,255,.045);
}


/* ---------------------------------------------------------
   CASE WITH IMAGE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-case-image {
  grid-template-columns:
    55px minmax(0, 1fr) 330px;
}


/* ---------------------------------------------------------
   NUMBER
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-number {
  padding-top: 25px;

  text-align: center;

  color: #657b94;

  font-size: 1.7rem;

  font-weight: 800;

  line-height: 1;
}


/* ---------------------------------------------------------
   CONTENT
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-content {
  padding: 25px 26px;
}


body:has(.home-hero) .mki-research-tag {
  color: #69adff;

  font-size: .61rem;

  font-weight: 800;

  letter-spacing: .12em;
}


body:has(.home-hero) .mki-research-content h3 {
  margin-top: 10px;

  color: #ffffff;

  font-size: 1.12rem;

  line-height: 1.3;
}


body:has(.home-hero) .mki-research-content p {
  max-width: 610px;

  margin-top: 9px;

  color: #b8c9da;

  font-size: .82rem;

  line-height: 1.65;
}


body:has(.home-hero) .mki-research-tools {
  margin-top: 14px;

  color: #6bb0ff;

  font-size: .59rem;

  font-weight: 800;

  letter-spacing: .05em;
}


/* ---------------------------------------------------------
   GRAPHENE IMAGE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-visual {
  min-height: 200px;

  padding: 18px 18px 18px 0;

  box-sizing: border-box;
}


body:has(.home-hero) .mki-research-visual img {
  display: block;

  width: 100%;
  height: 100%;

  min-height: 164px;

  object-fit: cover;

  object-position: center;

  border-radius: 10px;
}
/* =========================================================
   PART 6
   LEARNING ROADMAP
   ========================================================= */

body:has(.home-hero) .mki-roadmap {
  background:
    linear-gradient(
      135deg,
      #203951,
      #274967
    );

  color: #ffffff;
}


body:has(.home-hero) .mki-roadmap h2 {
  color: #ffffff;
}


body:has(.home-hero) .mki-roadmap .mki-section-intro {
  color: #c0d0e0;
}


body:has(.home-hero) .mki-roadmap-list {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;

  margin-top: 43px;
}


body:has(.home-hero) .mki-roadmap-item {
  min-height: 175px;

  padding: 23px;

  border: 1px solid rgba(191,218,241,.14);

  border-radius: 13px;

  background: rgba(255,255,255,.045);

  box-sizing: border-box;
}


body:has(.home-hero) .mki-roadmap-number {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 28px;
  height: 28px;

  border: 1px solid rgba(105,174,255,.42);

  border-radius: 50%;

  color: #6db0ff;

  font-size: .62rem;

  font-weight: 800;
}


body:has(.home-hero) .mki-roadmap-content {
  margin-top: 17px;
}


body:has(.home-hero) .mki-roadmap-content h3 {
  margin: 0;

  color: #ffffff;

  font-size: .96rem;
}


body:has(.home-hero) .mki-roadmap-content p {
  margin-top: 9px;

  color: #b7c8da;

  font-size: .77rem;

  line-height: 1.6;
}


body:has(.home-hero) .mki-roadmap-line {
  display: none;
}
/* =========================================================
   PART 7
   CONTRIBUTOR / WORKSHOP IDENTITY
   ========================================================= */

body:has(.home-hero) .mki-contributor {
  background:
    radial-gradient(
      circle at 85% 15%,
      rgba(111,171,235,.13),
      transparent 30%
    ),
    #edf3fa;
}


body:has(.home-hero) .mki-contributor-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 15px;

  margin-top: 43px;
}


body:has(.home-hero) .mki-contributor-person,
body:has(.home-hero) .mki-contributor-research {
  min-height: 190px;

  padding: 25px;

  border: 1px solid var(--mki-border);

  border-radius: 14px;

  background: rgba(255,255,255,.75);

  box-sizing: border-box;
}


body:has(.home-hero) .mki-contributor-role {
  color: var(--mki-blue);

  font-size: .62rem;

  font-weight: 800;

  letter-spacing: .12em;
}


body:has(.home-hero) .mki-contributor-person h3,
body:has(.home-hero) .mki-contributor-research h3 {
  margin-top: 11px;

  color: var(--mki-text);

  font-size: 1.1rem;
}


body:has(.home-hero) .mki-contributor-focus {
  margin-top: 10px;

  color: var(--mki-muted);

  font-size: .82rem;

  line-height: 1.65;
}
/* =========================================================
   PART 8
   RESPONSIVE
   ========================================================= */


/* ---------------------------------------------------------
   TABLET
   --------------------------------------------------------- */

@media screen and (max-width: 1000px) {

  body:has(.home-hero) .mki-features-inner,
  body:has(.home-hero) .mki-workflow-inner,
  body:has(.home-hero) .mki-questions-inner,
  body:has(.home-hero) .mki-research-inner,
  body:has(.home-hero) .mki-roadmap-inner,
  body:has(.home-hero) .mki-contributor-inner,
  body:has(.home-hero) .home-hero > .hero-content {
    width: calc(100% - 40px);
  }


  body:has(.home-hero) .mki-feature-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero) .mki-workflow-path {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero) .mki-research-case-image {
    grid-template-columns:
      55px minmax(0, 1fr);
  }


  body:has(.home-hero) .mki-research-visual {
    grid-column: 2;

    padding:
      0
      26px
      26px
      0;
  }


  body:has(.home-hero) .mki-roadmap-list {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media screen and (max-width: 700px) {

  body:has(.home-hero) .mki-features-inner,
  body:has(.home-hero) .mki-workflow-inner,
  body:has(.home-hero) .mki-questions-inner,
  body:has(.home-hero) .mki-research-inner,
  body:has(.home-hero) .mki-roadmap-inner,
  body:has(.home-hero) .mki-contributor-inner,
  body:has(.home-hero) .home-hero > .hero-content {
    width: calc(100% - 32px);
  }


  body:has(.home-hero) .home-hero {
    min-height: 570px;
  }


  body:has(.home-hero) .home-hero > .hero-content {
    padding-top: 65px;
    padding-bottom: 65px;
  }


  body:has(.home-hero) .home-hero h1 {
    font-size: 2.45rem;
  }


  body:has(.home-hero) .home-hero p {
    font-size: .88rem;
  }


  body:has(.home-hero) .hero-actions {
    flex-direction: column;
  }


  body:has(.home-hero) .hero-actions a {
    width: 235px;
  }


  body:has(.home-hero) .mki-features-inner,
  body:has(.home-hero) .mki-workflow-inner,
  body:has(.home-hero) .mki-questions-inner,
  body:has(.home-hero) .mki-research-inner,
  body:has(.home-hero) .mki-roadmap-inner,
  body:has(.home-hero) .mki-contributor-inner {
    padding-top: 62px;
    padding-bottom: 65px;
  }


  body:has(.home-hero) .mki-features h2,
  body:has(.home-hero) .mki-workflow h2,
  body:has(.home-hero) .mki-questions h2,
  body:has(.home-hero) .mki-research h2,
  body:has(.home-hero) .mki-roadmap h2,
  body:has(.home-hero) .mki-contributor h2 {
    font-size: 2rem;
  }


  body:has(.home-hero) .mki-feature-grid,
  body:has(.home-hero) .mki-workflow-path,
  body:has(.home-hero) .mki-roadmap-list,
  body:has(.home-hero) .mki-contributor-grid {
    grid-template-columns: 1fr;
  }


  body:has(.home-hero) .mki-research-case,
  body:has(.home-hero) .mki-research-case-image {
    grid-template-columns:
      45px minmax(0, 1fr);
  }


  body:has(.home-hero) .mki-research-visual {
    grid-column: 1 / -1;

    padding:
      0
      20px
      20px;
  }


  body:has(.home-hero) .mki-research-visual img {
    min-height: 180px;
  }

}
/* =========================================================
   MKI WORKSHOP HOME
   PART 2
   SECTION CONTAINER + TYPOGRAPHY
   ========================================================= */


/* =========================================================
   01. SHARED INNER WIDTH
   ========================================================= */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {

  width: min(
    1160px,
    calc(100% - 56px)
  );

  max-width: 1160px;

  margin-left: auto !important;
  margin-right: auto !important;

  box-sizing: border-box;
}


/* =========================================================
   02. SECTION SPACING
   ========================================================= */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {

  padding-top: 76px;
  padding-bottom: 76px;
}


/* =========================================================
   03. SECTION LABEL
   ========================================================= */

body:has(.home-hero) .section-label {

  display: inline-flex;

  align-items: center;

  width: auto !important;

  min-height: 29px;

  padding: 0 11px;

  box-sizing: border-box;

  border: 1px solid #cfe0f2;

  border-radius: 999px;

  background: #edf5fd;

  color: #3277d9;

  font-size: .62rem;

  font-weight: 800;

  letter-spacing: .13em;

  line-height: 1;

  text-transform: uppercase;
}


/* =========================================================
   04. SECTION HEADING
   ========================================================= */

body:has(.home-hero) .mki-features h2,
body:has(.home-hero) .mki-workflow h2,
body:has(.home-hero) .mki-questions h2,
body:has(.home-hero) .mki-research h2,
body:has(.home-hero) .mki-roadmap h2,
body:has(.home-hero) .mki-contributor h2 {

  max-width: 780px;

  margin-top: 17px;
  margin-bottom: 0;

  color: var(--mki-text);

  font-size: clamp(
    2rem,
    3.2vw,
    2.9rem
  );

  line-height: 1.08;

  letter-spacing: -.038em;

  font-weight: 800;
}


/* =========================================================
   05. HEADING ACCENT
   ========================================================= */

body:has(.home-hero) .mki-features h2::after,
body:has(.home-hero) .mki-workflow h2::after,
body:has(.home-hero) .mki-questions h2::after,
body:has(.home-hero) .mki-research h2::after,
body:has(.home-hero) .mki-roadmap h2::after,
body:has(.home-hero) .mki-contributor h2::after {

  content: "";

  display: block;

  width: 38px;

  height: 3px;

  margin-top: 18px;

  border-radius: 999px;

  background: var(--mki-blue);
}


/* =========================================================
   06. SECTION INTRO
   ========================================================= */

body:has(.home-hero) .mki-section-intro {

  max-width: 680px;

  margin-top: 15px;
  margin-bottom: 0;

  color: var(--mki-muted);

  font-size: .9rem;

  line-height: 1.68;
}


/* =========================================================
   07. DARK SECTION TYPOGRAPHY
   ========================================================= */

body:has(.home-hero) .mki-workflow h2,
body:has(.home-hero) .mki-research h2,
body:has(.home-hero) .mki-roadmap h2 {

  color: #ffffff;
}


body:has(.home-hero) .mki-workflow h2::after,
body:has(.home-hero) .mki-research h2::after,
body:has(.home-hero) .mki-roadmap h2::after {

  background: #6daeff;
}


body:has(.home-hero) .mki-workflow .mki-section-intro,
body:has(.home-hero) .mki-research .mki-section-intro,
body:has(.home-hero) .mki-roadmap .mki-section-intro {

  color: #b9cadd;
}


/* =========================================================
   08. PREVENT MARKDOWN MARGINS
   ========================================================= */

body:has(.home-hero) .mki-features-inner > :first-child,
body:has(.home-hero) .mki-workflow-inner > :first-child,
body:has(.home-hero) .mki-questions-inner > :first-child,
body:has(.home-hero) .mki-research-inner > :first-child,
body:has(.home-hero) .mki-roadmap-inner > :first-child,
body:has(.home-hero) .mki-contributor-inner > :first-child {

  margin-top: 0;
}
/* =========================================================
   MKI WORKSHOP HOME
   PART 3
   HERO
   ========================================================= */


/* =========================================================
   01. HERO BASE
   ========================================================= */

body:has(.home-hero) .home-hero {
  position: relative;

  width: 100%;

  min-height: 570px;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: hidden;

  box-sizing: border-box;

  background:
    linear-gradient(
      135deg,
      #294762 0%,
      #365b76 52%,
      #4a6e87 100%
    );

  color: #ffffff;
}


/* =========================================================
   02. HERO IMAGE
   ========================================================= */

body:has(.home-hero) .home-hero img {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;

  z-index: 0;
}


/* =========================================================
   03. IMAGE OVERLAY
   ========================================================= */

body:has(.home-hero) .home-hero::before {
  content: "";

  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(24, 51, 75, .68),
      rgba(37, 68, 94, .46),
      rgba(60, 91, 113, .30)
    );
}


/* =========================================================
   04. SOFT LIGHT
   ========================================================= */

body:has(.home-hero) .home-hero::after {
  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  top: -190px;
  right: -110px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(143, 203, 255, .24),
      transparent 68%
    );

  z-index: 2;

  pointer-events: none;
}


/* =========================================================
   05. HERO CONTENT
   ========================================================= */

body:has(.home-hero) .home-hero > .hero-content {

  position: relative;

  z-index: 3;

  width: min(
    1160px,
    calc(100% - 56px)
  );

  max-width: 1160px;

  margin-left: auto;
  margin-right: auto;

  padding-top: 72px;
  padding-bottom: 72px;

  box-sizing: border-box;

  text-align: center;
}


/* =========================================================
   06. HERO LABEL
   ========================================================= */

body:has(.home-hero) .hero-label {

  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 29px;

  padding: 0 13px;

  border: 1px solid rgba(255,255,255,.26);

  border-radius: 999px;

  background:
    rgba(255,255,255,.09);

  color: #e9f4ff;

  font-size: .62rem;

  font-weight: 800;

  letter-spacing: .13em;

  text-transform: uppercase;

  backdrop-filter: blur(7px);
}


/* =========================================================
   07. HERO TITLE
   ========================================================= */

body:has(.home-hero) .home-hero h1 {

  width: min(
    900px,
    100%
  );

  margin: 21px auto 0;

  color: #ffffff;

  font-size: clamp(
    2.75rem,
    4.7vw,
    4.25rem
  );

  line-height: 1.035;

  letter-spacing: -.048em;

  font-weight: 800;
}


/* =========================================================
   08. TITLE ACCENT
   ========================================================= */

body:has(.home-hero) .home-hero h1::after {

  content: "";

  display: block;

  width: 40px;

  height: 3px;

  margin: 20px auto 0;

  border-radius: 999px;

  background: #74b4ff;
}


/* =========================================================
   09. HERO DESCRIPTION
   ========================================================= */

body:has(.home-hero) .home-hero p {

  width: min(
    690px,
    100%
  );

  margin: 19px auto 0;

  color: #dce9f5;

  font-size: .92rem;

  line-height: 1.68;
}


/* =========================================================
   10. HERO ACTIONS
   ========================================================= */

body:has(.home-hero) .hero-actions {

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 10px;

  margin-top: 26px;
}


/* =========================================================
   11. HERO BUTTON
   ========================================================= */

body:has(.home-hero) .hero-actions a {

  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 42px;

  padding: 0 19px;

  box-sizing: border-box;

  border-radius: 8px;

  font-size: .79rem;

  font-weight: 700;

  line-height: 1;

  text-decoration: none !important;

  transition:
    transform .18s ease,
    background .18s ease,
    box-shadow .18s ease;
}


/* Primary */

body:has(.home-hero) .hero-actions a:first-child {

  background: #2f73e6;

  color: #ffffff;

  box-shadow:
    0 7px 20px rgba(22, 79, 164, .24);
}


body:has(.home-hero) .hero-actions a:first-child:hover {

  transform: translateY(-2px);

  background: #367ce9;

  box-shadow:
    0 10px 25px rgba(22, 79, 164, .30);
}


/* Secondary */

body:has(.home-hero) .hero-actions a:last-child {

  border: 1px solid rgba(255,255,255,.28);

  background:
    rgba(255,255,255,.08);

  color: #ffffff;

  backdrop-filter: blur(6px);
}


body:has(.home-hero) .hero-actions a:last-child:hover {

  background:
    rgba(255,255,255,.14);

  transform: translateY(-2px);
}


/* =========================================================
   12. HERO BOTTOM FADE
   ========================================================= */

body:has(.home-hero) .home-hero .hero-content::after {

  content: "";

  display: block;

  width: 5px;
  height: 5px;

  margin: 32px auto 0;

  border-radius: 50%;

  background: rgba(255,255,255,.45);

  box-shadow:
    -18px 0 0 rgba(255,255,255,.18),
    18px 0 0 rgba(255,255,255,.18);
}
/* =========================================================
   MKI WORKSHOP HOME
   PART 4
   FEATURES
   ========================================================= */


/* =========================================================
   01. FEATURES SECTION
   ========================================================= */

body:has(.home-hero) .mki-features {
  background:
    radial-gradient(
      circle at 88% 12%,
      rgba(100, 164, 229, .12),
      transparent 27%
    ),
    #f1f6fb;
}


/* =========================================================
   02. FEATURES HEADING
   ========================================================= */

body:has(.home-hero) .mki-features h2 {
  max-width: 820px;

  color: var(--mki-text);
}


/* =========================================================
   03. FEATURE GRID
   ========================================================= */

body:has(.home-hero) .mki-features-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-top: 42px;
}


/* =========================================================
   04. FEATURE CARD
   ========================================================= */

body:has(.home-hero) .mki-feature-card {
  position: relative;

  min-height: 205px;

  padding: 25px;

  box-sizing: border-box;

  border: 1px solid #d8e3ee;

  border-radius: 14px;

  background:
    rgba(255, 255, 255, .90);

  box-shadow:
    0 7px 24px rgba(35, 68, 101, .045);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}


/* =========================================================
   05. CARD HOVER
   ========================================================= */

body:has(.home-hero) .mki-feature-card:hover {

  transform: translateY(-3px);

  border-color: #c5d9ed;

  box-shadow:
    0 13px 30px rgba(35, 68, 101, .08);
}


/* =========================================================
   06. FEATURE ICON
   ========================================================= */

body:has(.home-hero) .mki-feature-icon {

  display: flex;

  align-items: center;
  justify-content: center;

  width: 31px;
  height: 31px;

  margin-bottom: 18px;

  box-sizing: border-box;

  border: 1px solid #c8dcf1;

  border-radius: 8px;

  background: #edf5fd;

  color: var(--mki-blue);

  font-size: .68rem;

  font-weight: 800;
}


/* =========================================================
   07. FEATURE TITLE
   ========================================================= */

body:has(.home-hero) .mki-feature-card h3 {

  margin: 0;

  color: var(--mki-text);

  font-size: 1.04rem;

  line-height: 1.3;

  font-weight: 750;
}


/* =========================================================
   08. FEATURE DESCRIPTION
   ========================================================= */

body:has(.home-hero) .mki-feature-card p {

  max-width: 330px;

  margin-top: 9px;

  color: var(--mki-muted);

  font-size: .81rem;

  line-height: 1.65;
}


/* =========================================================
   09. FEATURE TOOLS
   ========================================================= */

body:has(.home-hero) .mki-feature-tools {

  margin-top: 14px;

  color: var(--mki-blue);

  font-size: .60rem;

  font-weight: 800;

  letter-spacing: .055em;

  line-height: 1.5;
}


/* =========================================================
   10. SUBTLE TOP ACCENT
   ========================================================= */

body:has(.home-hero) .mki-feature-card::before {

  content: "";

  position: absolute;

  top: 0;
  left: 25px;

  width: 30px;
  height: 2px;

  border-radius: 99px;

  background: #5597e8;
}
/* =========================================================
   MKI WORKSHOP HOME
   PART 5
   SCIENTIFIC QUESTIONS
   ========================================================= */


/* =========================================================
   01. SECTION
   ========================================================= */

body:has(.home-hero) .mki-questions {
  background:
    linear-gradient(
      135deg,
      #eaf2fa 0%,
      #f4f8fc 100%
    );
}


/* =========================================================
   02. QUESTION GRID
   ========================================================= */

body:has(.home-hero) .mki-question-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 0;

  margin-top: 42px;

  border-top: 1px solid #d2dfeb;
  border-left: 1px solid #d2dfeb;
}


/* =========================================================
   03. QUESTION CARD
   ========================================================= */

body:has(.home-hero) .mki-question-card {

  display: grid;

  grid-template-columns: 36px minmax(0, 1fr);

  gap: 14px;

  min-height: 175px;

  padding: 24px;

  box-sizing: border-box;

  border-right: 1px solid #d2dfeb;
  border-bottom: 1px solid #d2dfeb;

  background:
    rgba(255,255,255,.52);

  transition:
    background .2s ease,
    box-shadow .2s ease;
}


/* =========================================================
   04. QUESTION HOVER
   ========================================================= */

body:has(.home-hero) .mki-question-card:hover {

  background:
    rgba(255,255,255,.88);

  box-shadow:
    inset 0 2px 0 var(--mki-blue);
}


/* =========================================================
   05. QUESTION NUMBER
   ========================================================= */

body:has(.home-hero) .mki-question-number {

  padding-top: 2px;

  color: var(--mki-blue);

  font-size: .66rem;

  font-weight: 800;

  letter-spacing: .08em;

  line-height: 1.4;
}


/* =========================================================
   06. QUESTION TITLE
   ========================================================= */

body:has(.home-hero) .mki-question-card h3 {

  margin: 0;

  color: var(--mki-text);

  font-size: 1rem;

  line-height: 1.3;

  font-weight: 750;
}


/* =========================================================
   07. QUESTION DESCRIPTION
   ========================================================= */

body:has(.home-hero) .mki-question-card p {

  margin-top: 9px;

  color: var(--mki-muted);

  font-size: .80rem;

  line-height: 1.65;
}


/* =========================================================
   08. QUESTION METHOD
   ========================================================= */

body:has(.home-hero) .mki-question-method {

  display: inline-block;

  margin-top: 13px;

  color: #3b78c5;

  font-size: .59rem;

  font-weight: 800;

  letter-spacing: .055em;

  line-height: 1.5;
}


/* =========================================================
   09. MOBILE
   ========================================================= */

@media screen and (max-width: 850px) {

  body:has(.home-hero) .mki-question-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


@media screen and (max-width: 600px) {

  body:has(.home-hero) .mki-question-grid {

    grid-template-columns: 1fr;
  }


  body:has(.home-hero) .mki-question-card {

    min-height: auto;
  }

}
/* =========================================================
   MKI WORKSHOP HOME
   PART 6
   RESEARCH CASES
   ========================================================= */


/* =========================================================
   01. RESEARCH SECTION
   ========================================================= */

body:has(.home-hero) .mki-research {

  background:
    linear-gradient(
      135deg,
      #1f3853 0%,
      #294a68 100%
    );

  color: #ffffff;
}


/* =========================================================
   02. RESEARCH HEADING
   ========================================================= */

body:has(.home-hero) .mki-research h2 {

  color: #ffffff;
}


body:has(.home-hero) .mki-research h2::after {

  background: #70b1ff;
}


body:has(.home-hero) .mki-research .mki-section-intro {

  color: #c3d2e1;
}


/* =========================================================
   03. RESEARCH LIST
   ========================================================= */

body:has(.home-hero) .mki-research-list {

  display: grid;

  gap: 14px;

  margin-top: 43px;
}


/* =========================================================
   04. RESEARCH CASE BASE
   ========================================================= */

body:has(.home-hero) .mki-research-case {

  display: grid;

  grid-template-columns:
    54px minmax(0, 1fr);

  min-height: 195px;

  overflow: hidden;

  box-sizing: border-box;

  border:
    1px solid
    rgba(193, 219, 241, .15);

  border-radius: 14px;

  background:
    rgba(255,255,255,.045);

  transition:
    border-color .2s ease,
    background .2s ease;
}


/* =========================================================
   05. RESEARCH CASE HOVER
   ========================================================= */

body:has(.home-hero) .mki-research-case:hover {

  border-color:
    rgba(112,177,255,.30);

  background:
    rgba(255,255,255,.065);
}


/* =========================================================
   06. CASE WITH IMAGE
   ========================================================= */

body:has(.home-hero) .mki-research-case-image {

  grid-template-columns:
    54px minmax(0, 1fr) 340px;
}


/* =========================================================
   07. CASE NUMBER
   ========================================================= */

body:has(.home-hero) .mki-research-number {

  padding-top: 25px;

  text-align: center;

  color: #637b94;

  font-size: 1.65rem;

  font-weight: 800;

  line-height: 1;
}


/* =========================================================
   08. CASE CONTENT
   ========================================================= */

body:has(.home-hero) .mki-research-content {

  padding:
    25px
    27px;
}


/* =========================================================
   09. CASE CATEGORY
   ========================================================= */

body:has(.home-hero) .mki-research-tag {

  color: #6db0ff;

  font-size: .60rem;

  font-weight: 800;

  letter-spacing: .12em;

  line-height: 1.4;
}


/* =========================================================
   10. CASE TITLE
   ========================================================= */

body:has(.home-hero) .mki-research-content h3 {

  margin-top: 10px;

  color: #ffffff;

  font-size: 1.12rem;

  line-height: 1.3;

  font-weight: 750;
}


/* =========================================================
   11. CASE DESCRIPTION
   ========================================================= */

body:has(.home-hero) .mki-research-content p {

  max-width: 620px;

  margin-top: 9px;

  color: #b9cadb;

  font-size: .81rem;

  line-height: 1.65;
}


/* =========================================================
   12. CASE TOOLS
   ========================================================= */

body:has(.home-hero) .mki-research-tools {

  margin-top: 14px;

  color: #6fb2ff;

  font-size: .59rem;

  font-weight: 800;

  letter-spacing: .045em;

  line-height: 1.5;
}


/* =========================================================
   13. IMAGE CONTAINER
   ========================================================= */

body:has(.home-hero) .mki-research-visual {

  min-height: 195px;

  padding:
    17px
    17px
    17px
    0;

  box-sizing: border-box;
}


/* =========================================================
   14. RESEARCH IMAGE
   ========================================================= */

body:has(.home-hero) .mki-research-visual img {

  display: block;

  width: 100%;
  height: 100%;

  min-height: 161px;

  object-fit: cover;

  object-position: center;

  box-sizing: border-box;

  border-radius: 10px;

  border:
    1px solid
    rgba(255,255,255,.10);

  box-shadow:
    0 8px 25px
    rgba(0,0,0,.18);
}


/* =========================================================
   15. IMAGE HOVER
   ========================================================= */

body:has(.home-hero) .mki-research-visual img {

  transition:
    transform .25s ease,
    filter .25s ease;
}


body:has(.home-hero) .mki-research-case:hover
.mki-research-visual img {

  transform: scale(1.015);

  filter: brightness(1.04);
}


/* =========================================================
   16. CASE 02 AND 03 VISUAL BALANCE
   ========================================================= */

body:has(.home-hero)
.mki-research-case:not(.mki-research-case-image)
.mki-research-content {

  padding-right: 90px;
}


/* =========================================================
   17. MOBILE
   ========================================================= */

@media screen and (max-width: 900px) {

  body:has(.home-hero)
  .mki-research-case-image {

    grid-template-columns:
      54px minmax(0, 1fr);
  }


  body:has(.home-hero)
  .mki-research-case-image
  .mki-research-visual {

    grid-column: 2;

    padding:
      0
      27px
      27px
      0;
  }

}


@media screen and (max-width: 600px) {

  body:has(.home-hero) .mki-research-case,
  body:has(.home-hero) .mki-research-case-image {

    grid-template-columns:
      42px minmax(0, 1fr);
  }


  body:has(.home-hero) .mki-research-number {

    padding-top: 23px;

    font-size: 1.35rem;
  }


  body:has(.home-hero) .mki-research-content {

    padding:
      23px
      18px
      23px
      8px;
  }


  body:has(.home-hero)
  .mki-research-case:not(.mki-research-case-image)
  .mki-research-content {

    padding-right: 18px;
  }


  body:has(.home-hero)
  .mki-research-case-image
  .mki-research-visual {

    grid-column: 1 / -1;

    padding:
      0
      18px
      18px;
  }


  body:has(.home-hero)
  .mki-research-visual img {

    min-height: 175px;
  }

}
/* =========================================================
   MKI WORKSHOP HOME
   PART 7
   LEARNING ROADMAP
   ========================================================= */


/* =========================================================
   01. ROADMAP SECTION
   ========================================================= */

body:has(.home-hero) .mki-roadmap {
  background:
    radial-gradient(
      circle at 82% 12%,
      rgba(102, 169, 232, .13),
      transparent 28%
    ),
    #eaf1f8;

  color: var(--mki-text);
}


/* =========================================================
   02. ROADMAP HEADING
   ========================================================= */

body:has(.home-hero) .mki-roadmap h2 {
  color: var(--mki-text);
}


body:has(.home-hero) .mki-roadmap h2::after {
  background: var(--mki-blue);
}


/* =========================================================
   03. ROADMAP INTRO
   ========================================================= */

body:has(.home-hero) .mki-roadmap .mki-section-intro {
  color: var(--mki-muted);
}


/* =========================================================
   04. ROADMAP LIST
   ========================================================= */

body:has(.home-hero) .mki-roadmap-list {
  position: relative;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-top: 43px;
}


/* =========================================================
   05. ROADMAP ITEM
   ========================================================= */

body:has(.home-hero) .mki-roadmap-item {

  position: relative;

  min-height: 178px;

  padding: 23px;

  box-sizing: border-box;

  border:
    1px solid
    #d5e1ec;

  border-radius: 13px;

  background:
    rgba(255,255,255,.72);

  box-shadow:
    0 6px 22px
    rgba(37, 68, 101, .035);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}


/* =========================================================
   06. ROADMAP HOVER
   ========================================================= */

body:has(.home-hero) .mki-roadmap-item:hover {

  transform: translateY(-3px);

  border-color:
    #c3d7ea;

  box-shadow:
    0 12px 27px
    rgba(37, 68, 101, .075);
}


/* =========================================================
   07. ROADMAP NUMBER
   ========================================================= */

body:has(.home-hero) .mki-roadmap-number {

  display: flex;

  align-items: center;
  justify-content: center;

  width: 29px;
  height: 29px;

  border:
    1px solid
    #bcd4ec;

  border-radius: 50%;

  background:
    #edf5fd;

  color:
    var(--mki-blue);

  font-size: .61rem;

  font-weight: 800;

  line-height: 1;
}


/* =========================================================
   08. ROADMAP CONTENT
   ========================================================= */

body:has(.home-hero) .mki-roadmap-content {

  margin-top: 17px;
}


/* =========================================================
   09. ROADMAP TITLE
   ========================================================= */

body:has(.home-hero) .mki-roadmap-content h3 {

  margin: 0;

  color: var(--mki-text);

  font-size: .97rem;

  line-height: 1.3;

  font-weight: 750;
}


/* =========================================================
   10. ROADMAP DESCRIPTION
   ========================================================= */

body:has(.home-hero) .mki-roadmap-content p {

  max-width: 330px;

  margin-top: 9px;

  color: var(--mki-muted);

  font-size: .78rem;

  line-height: 1.62;
}


/* =========================================================
   11. ROADMAP LINE
   ========================================================= */

/*
   The original HTML contains .mki-roadmap-line.
   We keep it hidden because the CSS grid already provides
   the visual sequence. This prevents unwanted long vertical
   lines on desktop.
*/

body:has(.home-hero) .mki-roadmap-line {
  display: none;
}


/* =========================================================
   12. DESKTOP SEQUENCE ACCENT
   ========================================================= */

@media screen and (min-width: 901px) {

  body:has(.home-hero)
  .mki-roadmap-item:nth-child(3n + 1)::after {

    content: "";

    position: absolute;

    top: 37px;
    right: -9px;

    width: 17px;
    height: 1px;

    background:
      #b9cee3;

    z-index: 2;
  }


  body:has(.home-hero)
  .mki-roadmap-item:nth-child(3n + 2)::after {

    content: "";

    position: absolute;

    top: 37px;
    right: -9px;

    width: 17px;
    height: 1px;

    background:
      #b9cee3;

    z-index: 2;
  }

}


/* =========================================================
   13. TABLET
   ========================================================= */

@media screen and (max-width: 900px) {

  body:has(.home-hero) .mki-roadmap-list {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* =========================================================
   14. MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

  body:has(.home-hero) .mki-roadmap-list {

    grid-template-columns: 1fr;

    gap: 12px;
  }


  body:has(.home-hero) .mki-roadmap-item {

    min-height: auto;

    padding: 21px;
  }

}
/* =========================================================
   MKI WORKSHOP HOME
   PART 8
   CONTRIBUTOR + ITB + BRIN + FINAL RESPONSIVE
   ========================================================= */


/* =========================================================
   01. CONTRIBUTOR SECTION
   ========================================================= */

body:has(.home-hero) .mki-contributor {
  background:
    radial-gradient(
      circle at 88% 10%,
      rgba(92, 157, 225, .13),
      transparent 28%
    ),
    #edf3f9;

  color: var(--mki-text);
}


/* =========================================================
   02. CONTRIBUTOR HEADING
   ========================================================= */

body:has(.home-hero) .mki-contributor h2 {
  color: var(--mki-text);
}


body:has(.home-hero) .mki-contributor h2::after {
  background: var(--mki-blue);
}


/* =========================================================
   03. CONTRIBUTOR GRID
   ========================================================= */

body:has(.home-hero) .mki-contributor-grid {

  display: grid;

  grid-template-columns:
    minmax(0, .85fr)
    minmax(0, 1.15fr);

  gap: 16px;

  margin-top: 43px;
}


/* =========================================================
   04. CONTRIBUTOR BOX
   ========================================================= */

body:has(.home-hero) .mki-contributor-person,
body:has(.home-hero) .mki-contributor-research {

  min-height: 190px;

  padding: 25px;

  box-sizing: border-box;

  border:
    1px solid
    #d5e1ec;

  border-radius: 14px;

  background:
    rgba(255,255,255,.72);

  box-shadow:
    0 6px 22px
    rgba(39,72,104,.035);
}


/* =========================================================
   05. CONTRIBUTOR ROLE
   ========================================================= */

body:has(.home-hero) .mki-contributor-role {

  color: var(--mki-blue);

  font-size: .61rem;

  font-weight: 800;

  letter-spacing: .12em;

  line-height: 1.4;

  text-transform: uppercase;
}


/* =========================================================
   06. CONTRIBUTOR TITLE
   ========================================================= */

body:has(.home-hero)
.mki-contributor-person h3,
body:has(.home-hero)
.mki-contributor-research h3 {

  margin-top: 11px;

  color: var(--mki-text);

  font-size: 1.1rem;

  line-height: 1.3;

  font-weight: 750;
}


/* =========================================================
   07. CONTRIBUTOR DESCRIPTION
   ========================================================= */

body:has(.home-hero) .mki-contributor-focus {

  max-width: 520px;

  margin-top: 10px;

  color: var(--mki-muted);

  font-size: .82rem;

  line-height: 1.65;
}


/* =========================================================
   08. INSTITUTIONAL ACCENT
   ========================================================= */

body:has(.home-hero)
.mki-contributor-research::before {

  content: "ITB × BRIN";

  display: inline-flex;

  align-items: center;

  min-height: 27px;

  padding: 0 10px;

  box-sizing: border-box;

  border-radius: 999px;

  background: #eaf3fd;

  color: #3278d8;

  font-size: .60rem;

  font-weight: 800;

  letter-spacing: .09em;
}


/* =========================================================
   09. FUTURE CONTRIBUTORS
   ========================================================= */

body:has(.home-hero)
.mki-contributor-person::after {

  content: "Additional contributors will be added";

  display: block;

  margin-top: 18px;

  color: #8496aa;

  font-size: .68rem;

  font-style: italic;

  line-height: 1.5;
}


/* =========================================================
   10. ITB / BRIN TEXT
   ========================================================= */

body:has(.home-hero)
.mki-contributor-research strong {

  color: var(--mki-text);
}


/* =========================================================
   11. FINAL SECTION RHYTHM
   ========================================================= */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {

  scroll-margin-top: 80px;
}


/* =========================================================
   12. TABLET
   ========================================================= */

@media screen and (max-width: 1000px) {

  body:has(.home-hero)
  .mki-features-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero)
  .mki-workflow-path {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero)
  .mki-roadmap-list {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero)
  .mki-contributor-grid {

    grid-template-columns: 1fr;
  }


  body:has(.home-hero)
  .mki-research-case-image {

    grid-template-columns:
      54px minmax(0, 1fr);
  }


  body:has(.home-hero)
  .mki-research-case-image
  .mki-research-visual {

    grid-column: 2;

    padding:
      0
      27px
      27px
      0;
  }

}


/* =========================================================
   13. MOBILE
   ========================================================= */

@media screen and (max-width: 700px) {

  body:has(.home-hero)
  .mki-features-inner,
  body:has(.home-hero)
  .mki-workflow-inner,
  body:has(.home-hero)
  .mki-questions-inner,
  body:has(.home-hero)
  .mki-research-inner,
  body:has(.home-hero)
  .mki-roadmap-inner,
  body:has(.home-hero)
  .mki-contributor-inner,
  body:has(.home-hero)
  .home-hero > .hero-content {

    width:
      calc(100% - 32px);
  }


  /* -------------------------------------------------------
     HERO
     ------------------------------------------------------- */

  body:has(.home-hero) .home-hero {

    min-height: 550px;
  }


  body:has(.home-hero)
  .home-hero > .hero-content {

    padding-top: 60px;
    padding-bottom: 60px;
  }


  body:has(.home-hero)
  .home-hero h1 {

    font-size: 2.4rem;

    letter-spacing: -.04em;
  }


  body:has(.home-hero)
  .home-hero p {

    font-size: .86rem;
  }


  body:has(.home-hero)
  .hero-actions {

    flex-direction: column;

    gap: 8px;
  }


  body:has(.home-hero)
  .hero-actions a {

    width: 230px;
  }


  /* -------------------------------------------------------
     SECTIONS
     ------------------------------------------------------- */

  body:has(.home-hero)
  .mki-features-inner,
  body:has(.home-hero)
  .mki-workflow-inner,
  body:has(.home-hero)
  .mki-questions-inner,
  body:has(.home-hero)
  .mki-research-inner,
  body:has(.home-hero)
  .mki-roadmap-inner,
  body:has(.home-hero)
  .mki-contributor-inner {

    padding-top: 60px;
    padding-bottom: 62px;
  }


  /* -------------------------------------------------------
     HEADINGS
     ------------------------------------------------------- */

  body:has(.home-hero)
  .mki-features h2,
  body:has(.home-hero)
  .mki-workflow h2,
  body:has(.home-hero)
  .mki-questions h2,
  body:has(.home-hero)
  .mki-research h2,
  body:has(.home-hero)
  .mki-roadmap h2,
  body:has(.home-hero)
  .mki-contributor h2 {

    font-size: 1.95rem;

    letter-spacing: -.032em;
  }


  /* -------------------------------------------------------
     GRIDS
     ------------------------------------------------------- */

  body:has(.home-hero)
  .mki-features-grid,
  body:has(.home-hero)
  .mki-workflow-path,
  body:has(.home-hero)
  .mki-roadmap-list,
  body:has(.home-hero)
  .mki-contributor-grid {

    grid-template-columns: 1fr;
  }


  /* -------------------------------------------------------
     QUESTION GRID
     ------------------------------------------------------- */

  body:has(.home-hero)
  .mki-question-grid {

    grid-template-columns: 1fr;
  }


  /* -------------------------------------------------------
     RESEARCH CASE
     ------------------------------------------------------- */

  body:has(.home-hero)
  .mki-research-case,
  body:has(.home-hero)
  .mki-research-case-image {

    grid-template-columns:
      42px minmax(0, 1fr);

    min-height: auto;
  }


  body:has(.home-hero)
  .mki-research-number {

    padding-top: 22px;

    font-size: 1.3rem;
  }


  body:has(.home-hero)
  .mki-research-content {

    padding:
      22px
      18px
      22px
      8px;
  }


  body:has(.home-hero)
  .mki-research-case-image
  .mki-research-visual {

    grid-column: 1 / -1;

    padding:
      0
      18px
      18px;
  }


  body:has(.home-hero)
  .mki-research-visual img {

    min-height: 175px;
  }


  /* -------------------------------------------------------
     CARDS
     ------------------------------------------------------- */

  body:has(.home-hero)
  .mki-feature-card,
  body:has(.home-hero)
  .mki-roadmap-item {

    min-height: auto;
  }

}
/* =========================================================
   MKI WORKSHOP HOME
   PART 9
   HTML COMPATIBILITY + FINAL POLISH
   ========================================================= */


/* =========================================================
   01. FEATURES
   SUPPORT BOTH POSSIBLE GRID CLASS NAMES
   ========================================================= */

body:has(.home-hero) .mki-features-grid,
body:has(.home-hero) .mki-feature-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-top: 42px;
}


/* =========================================================
   02. FEATURE CARDS
   ========================================================= */

body:has(.home-hero) .mki-feature-card,
body:has(.home-hero) .mki-feature {

  position: relative;

  min-height: 195px;

  padding: 24px;

  box-sizing: border-box;

  border:
    1px solid
    #d8e3ee;

  border-radius: 14px;

  background:
    rgba(255,255,255,.88);

  box-shadow:
    0 7px 24px
    rgba(35,68,101,.045);
}


/* =========================================================
   03. FEATURE CARD ACCENT
   ========================================================= */

body:has(.home-hero) .mki-feature-card::before,
body:has(.home-hero) .mki-feature::before {

  content: "";

  position: absolute;

  top: 0;
  left: 24px;

  width: 28px;
  height: 2px;

  border-radius: 999px;

  background:
    var(--mki-blue);
}


/* =========================================================
   04. QUESTIONS
   ========================================================= */

body:has(.home-hero) .mki-question-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 0;

  margin-top: 42px;

  border-top:
    1px solid
    #d2deea;

  border-left:
    1px solid
    #d2deea;
}


body:has(.home-hero) .mki-question-card {

  min-height: 175px;

  padding: 23px;

  box-sizing: border-box;

  border-right:
    1px solid
    #d2deea;

  border-bottom:
    1px solid
    #d2deea;

  background:
    rgba(255,255,255,.50);
}


/* =========================================================
   05. QUESTION TYPOGRAPHY
   ========================================================= */

body:has(.home-hero) .mki-question-card h3 {

  margin: 0;

  color:
    var(--mki-text);

  font-size: .98rem;

  line-height: 1.3;
}


body:has(.home-hero) .mki-question-card p {

  margin-top: 9px;

  color:
    var(--mki-muted);

  font-size: .80rem;

  line-height: 1.62;
}


/* =========================================================
   06. REMOVE UNWANTED MARKDOWN ELEMENT SPACING
   ========================================================= */

body:has(.home-hero) .mki-features p:last-child,
body:has(.home-hero) .mki-workflow p:last-child,
body:has(.home-hero) .mki-questions p:last-child,
body:has(.home-hero) .mki-research p:last-child,
body:has(.home-hero) .mki-roadmap p:last-child,
body:has(.home-hero) .mki-contributor p:last-child {

  margin-bottom: 0;
}


/* =========================================================
   07. LINKS INSIDE HOME
   ========================================================= */

body:has(.home-hero) .mki-features a,
body:has(.home-hero) .mki-workflow a,
body:has(.home-hero) .mki-questions a,
body:has(.home-hero) .mki-research a,
body:has(.home-hero) .mki-roadmap a,
body:has(.home-hero) .mki-contributor a {

  text-decoration-thickness: 1px;

  text-underline-offset: 3px;
}


/* =========================================================
   08. CODE ELEMENTS
   ========================================================= */

body:has(.home-hero) .mki-features code,
body:has(.home-hero) .mki-workflow code,
body:has(.home-hero) .mki-questions code,
body:has(.home-hero) .mki-research code,
body:has(.home-hero) .mki-roadmap code {

  border-radius: 5px;

  font-size: .78em;
}


/* =========================================================
   09. DESKTOP CONTENT WIDTH
   ========================================================= */

@media screen and (min-width: 1200px) {

  body:has(.home-hero)
  .mki-features-inner,
  body:has(.home-hero)
  .mki-workflow-inner,
  body:has(.home-hero)
  .mki-questions-inner,
  body:has(.home-hero)
  .mki-research-inner,
  body:has(.home-hero)
  .mki-roadmap-inner,
  body:has(.home-hero)
  .mki-contributor-inner {

    width: 1160px;
    max-width: 1160px;
  }

}


/* =========================================================
   10. TABLET
   ========================================================= */

@media screen and (max-width: 900px) {

  body:has(.home-hero) .mki-features-grid,
  body:has(.home-hero) .mki-feature-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero) .mki-question-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero) .mki-workflow-path {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  body:has(.home-hero) .mki-roadmap-list {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* =========================================================
   11. SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

  body:has(.home-hero) .mki-features-grid,
  body:has(.home-hero) .mki-feature-grid,
  body:has(.home-hero) .mki-question-grid,
  body:has(.home-hero) .mki-workflow-path,
  body:has(.home-hero) .mki-roadmap-list {

    grid-template-columns: 1fr;
  }


  body:has(.home-hero) .mki-question-card {

    min-height: auto;

    padding: 21px;
  }


  body:has(.home-hero) .mki-feature-card,
  body:has(.home-hero) .mki-feature {

    padding: 22px;
  }

}
/* =========================================================
   MKI WORKSHOP HOME
   PART 10
   FINAL VISUAL POLISH
   ========================================================= */


/* =========================================================
   01. NAVBAR
   ========================================================= */

/*
   Navbar tetap menggunakan sistem Material.
   Kita hanya membuatnya menyatu dengan homepage.
*/

body:has(.home-hero) .md-header {

  box-shadow:
    0 1px 0 rgba(255,255,255,.08);

}


/* =========================================================
   02. NAVBAR TITLE
   ========================================================= */

body:has(.home-hero) .md-header__title {

  font-weight: 700;

}


/* =========================================================
   03. NAVIGATION LINKS
   ========================================================= */

body:has(.home-hero) .md-tabs {

  background:
    var(--mki-navy);

}


/* =========================================================
   04. MAIN CONTENT
   ========================================================= */

body:has(.home-hero) .md-content {

  min-width: 0;

}


/* =========================================================
   05. PREVENT UNEXPECTED MARKDOWN WIDTH
   ========================================================= */

body:has(.home-hero) .md-typeset {

  max-width: none;

}


/* =========================================================
   06. IMAGES
   ========================================================= */

body:has(.home-hero) .md-typeset img {

  max-width: 100%;

}


/* =========================================================
   07. HERO IMAGE QUALITY
   ========================================================= */

body:has(.home-hero) .home-hero img {

  image-rendering: auto;

}


/* =========================================================
   08. SECTION TRANSITION
   ========================================================= */

body:has(.home-hero)
.mki-features,
body:has(.home-hero)
.mki-questions,
body:has(.home-hero)
.mki-roadmap {

  border-top:
    1px solid
    rgba(30,65,100,.035);

}


/* =========================================================
   09. DARK SECTION TRANSITION
   ========================================================= */

body:has(.home-hero)
.mki-workflow,
body:has(.home-hero)
.mki-research {

  border-top:
    1px solid
    rgba(255,255,255,.035);

}


/* =========================================================
   10. SELECTION
   ========================================================= */

body:has(.home-hero) ::selection {

  background:
    rgba(47,115,230,.20);

}


/* =========================================================
   11. FOCUS
   ========================================================= */

body:has(.home-hero) a:focus-visible {

  outline:
    2px solid
    #69aaff;

  outline-offset: 3px;

}


/* =========================================================
   12. REDUCE EXCESSIVE MARKDOWN MARGINS
   ========================================================= */

body:has(.home-hero) .md-typeset h1,
body:has(.home-hero) .md-typeset h2,
body:has(.home-hero) .md-typeset h3 {

  scroll-margin-top: 90px;

}


/* =========================================================
   13. FOOTER
   ========================================================= */

body:has(.home-hero) .md-footer {

  background:
    #172d45;

}


body:has(.home-hero) .md-footer-meta {

  background:
    #13283e;

}


/* =========================================================
   14. FOOTER TEXT
   ========================================================= */

body:has(.home-hero) .md-footer-meta,
body:has(.home-hero) .md-footer-meta a {

  color:
    #aebfd1;

}


/* =========================================================
   15. FOOTER LINKS
   ========================================================= */

body:has(.home-hero) .md-footer a:hover {

  color:
    #ffffff;

}


/* =========================================================
   16. REMOVE UNNECESSARY HOME CONTENT WIDTH
   ========================================================= */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {

  overflow: visible;

}


/* =========================================================
   17. SMOOTH HORIZONTAL RHYTHM
   ========================================================= */

body:has(.home-hero) .mki-section-intro {

  letter-spacing: -.005em;

}


/* =========================================================
   18. DESKTOP
   ========================================================= */

@media screen and (min-width: 1200px) {

  body:has(.home-hero) .mki-features-inner,
  body:has(.home-hero) .mki-workflow-inner,
  body:has(.home-hero) .mki-questions-inner,
  body:has(.home-hero) .mki-research-inner,
  body:has(.home-hero) .mki-roadmap-inner,
  body:has(.home-hero) .mki-contributor-inner {

    width: 1160px;

  }

}


/* =========================================================
   19. TABLET
   ========================================================= */

@media screen and (max-width: 900px) {

  body:has(.home-hero) .mki-features-inner,
  body:has(.home-hero) .mki-workflow-inner,
  body:has(.home-hero) .mki-questions-inner,
  body:has(.home-hero) .mki-research-inner,
  body:has(.home-hero) .mki-roadmap-inner,
  body:has(.home-hero) .mki-contributor-inner {

    width:
      calc(100% - 40px);

  }

}


/* =========================================================
   20. MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

  body:has(.home-hero) .mki-features-inner,
  body:has(.home-hero) .mki-workflow-inner,
  body:has(.home-hero) .mki-questions-inner,
  body:has(.home-hero) .mki-research-inner,
  body:has(.home-hero) .mki-roadmap-inner,
  body:has(.home-hero) .mki-contributor-inner {

    width:
      calc(100% - 28px);

  }


  body:has(.home-hero) .section-label {

    font-size: .58rem;

    letter-spacing: .11em;

  }


  body:has(.home-hero) .mki-section-intro {

    font-size: .84rem;

  }

}
/* =========================================================
   MKI WORKSHOP HOME
   PART 11
   FINAL SPACING + IMAGE + RESPONSIVE SAFETY
   ========================================================= */


/* =========================================================
   01. GLOBAL HOME SPACING
   ========================================================= */

body:has(.home-hero) .mki-features,
body:has(.home-hero) .mki-workflow,
body:has(.home-hero) .mki-questions,
body:has(.home-hero) .mki-research,
body:has(.home-hero) .mki-roadmap,
body:has(.home-hero) .mki-contributor {

  margin: 0 !important;

  border: 0;
}


/* =========================================================
   02. PREVENT EMPTY MARKDOWN SPACE
   ========================================================= */

body:has(.home-hero) .mki-features-inner > br,
body:has(.home-hero) .mki-workflow-inner > br,
body:has(.home-hero) .mki-questions-inner > br,
body:has(.home-hero) .mki-research-inner > br,
body:has(.home-hero) .mki-roadmap-inner > br,
body:has(.home-hero) .mki-contributor-inner > br {

  display: none !important;
}


/* =========================================================
   03. IMAGE SAFETY
   ========================================================= */

body:has(.home-hero)
.mki-research-visual {

  overflow: hidden;
}


body:has(.home-hero)
.mki-research-visual img {

  display: block !important;

  max-width: none !important;

  width: 100% !important;

  height: 100% !important;

  object-fit: cover !important;

  object-position: center !important;
}


/* =========================================================
   04. GRAPHENE IMAGE
   ========================================================= */

body:has(.home-hero)
.mki-research-case-image
.mki-research-visual {

  align-self: stretch;
}


body:has(.home-hero)
.mki-research-case-image
.mki-research-visual img {

  min-width: 0;

  min-height: 160px;
}


/* =========================================================
   05. TEXT SHOULD NEVER PUSH LAYOUT
   ========================================================= */

body:has(.home-hero)
.mki-research-content,
body:has(.home-hero)
.mki-feature-card,
body:has(.home-hero)
.mki-feature,
body:has(.home-hero)
.mki-question-card,
body:has(.home-hero)
.mki-roadmap-item {

  min-width: 0;

  overflow-wrap: break-word;
}


/* =========================================================
   06. TOOL LABELS
   ========================================================= */

body:has(.home-hero)
.mki-research-tools,
body:has(.home-hero)
.mki-feature-tools,
body:has(.home-hero)
.mki-question-method {

  overflow-wrap: anywhere;
}


/* =========================================================
   07. HEADING WIDTH
   ========================================================= */

body:has(.home-hero)
.mki-features h2,
body:has(.home-hero)
.mki-workflow h2,
body:has(.home-hero)
.mki-questions h2,
body:has(.home-hero)
.mki-research h2,
body:has(.home-hero)
.mki-roadmap h2,
body:has(.home-hero)
.mki-contributor h2 {

  width: 100%;

  max-width: 780px;
}


/* =========================================================
   08. HERO WIDTH
   ========================================================= */

body:has(.home-hero)
.home-hero {

  margin-left: 0 !important;

  margin-right: 0 !important;
}


/* =========================================================
   09. HERO CONTENT SAFETY
   ========================================================= */

body:has(.home-hero)
.home-hero > .hero-content {

  box-sizing: border-box;

  min-width: 0;
}


/* =========================================================
   10. BUTTON SAFETY
   ========================================================= */

body:has(.home-hero)
.hero-actions a {

  white-space: nowrap;
}


/* =========================================================
   11. DESKTOP IMAGE PROPORTION
   ========================================================= */

@media screen and (min-width: 1001px) {

  body:has(.home-hero)
  .mki-research-case-image {

    grid-template-columns:
      54px
      minmax(0, 1fr)
      340px;

  }


  body:has(.home-hero)
