&CONTROL
    calculation = 'scf'
    prefix = 'graphene'
    pseudo_dir = '../pseudo/'
    outdir = './tmp/'
/

&SYSTEM
    ibrav = 4
    celldm(1) = 4.65
    celldm(3) = 8.00

    nat = 2
    ntyp = 1

    ecutwfc = 50
    ecutrho = 400

    occupations = 'smearing'
    smearing = 'gaussian'
    degauss = 0.01
/

&ELECTRONS
    conv_thr = 1.0d-8
    mixing_mode = 'plain'
    mixing_beta = 0.7
/


ATOMIC_SPECIES

C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF


ATOMIC_POSITIONS crystal

C  0.0000  0.0000  0.0000

C  0.3333  0.6667  0.0000



K_POINTS automatic

12 12 1 0 0 0
