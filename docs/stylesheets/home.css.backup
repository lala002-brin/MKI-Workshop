   ========================================================= */

@media screen and (max-width: 900px) {

  body:has(.home-hero)
  .mki-features-inner,
  body:has(.home-hero)
  .mki-workflow-inner,
  body:has(.home-hero)
  .mki-questions-inner,
  body:has(.home-hero)
  .mki-research-inner,
  body:has(.home-hero)
  .mki-roadmap-inner,
