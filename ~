
   MKI WORKSHOP HOME
   PART 1
   FOUNDATION
   ========================================================= */


/* ---------------------------------------------------------
   HOME VARIABLES
   --------------------------------------------------------- */

body:has(.home-hero) {
  --mki-blue: #2f73e6;
  --mki-blue-soft: #eaf3ff;

  --mki-navy: #203a57;
  --mki-navy-deep: #182f49;

  --mki-bg: #f3f7fb;
  --mki-bg-white: #ffffff;
  --mki-bg-blue: #eaf2fa;

  --mki-text: #172b45;
  --mki-muted: #63758c;

  --mki-border: #d9e4ef;

  --mki-container: 1160px;
}


/* ---------------------------------------------------------
   HOME ONLY
   --------------------------------------------------------- */

body:has(.home-hero) .md-main {
  background: var(--mki-bg);
}


/* ---------------------------------------------------------
   DO NOT DISTURB MATERIAL GRID
   --------------------------------------------------------- */

body:has(.home-hero) .md-grid {
  box-sizing: border-box;
}


/* ---------------------------------------------------------
   HOME CONTENT
   --------------------------------------------------------- */

body:has(.home-hero) .md-content {
  box-sizing: border-box;
}


/* ---------------------------------------------------------
   TYPOGRAPHY RESET
   --------------------------------------------------------- */

body:has(.home-hero) .md-typeset {
  color: var(--mki-text);
}


/* ---------------------------------------------------------
   HOME SECTION
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features,
body:has(.home-hero) .mki-workflow,
body:has(.home-hero) .mki-questions,
body:has(.home-hero) .mki-research,
body:has(.home-hero) .mki-roadmap,
body:has(.home-hero) .mki-contributor {
  width: 100%;
  box-sizing: border-box;
}


/* ---------------------------------------------------------
   INNER CONTAINERS
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {
  width: min(
    var(--mki-container),
    calc(100% - 48px)
  );

  max-width: var(--mki-container);

  margin-left: auto;
  margin-right: auto;

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   SECTION SPACING
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {
  padding-top: 76px;
  padding-bottom: 76px;
}


/* ---------------------------------------------------------
   REMOVE DEFAULT MARKDOWN SPACING
   --------------------------------------------------------- */

body:has(.home-hero) .md-typeset > section:first-child {
  margin-top: 0;
}


/* ---------------------------------------------------------
   SECTION HEADINGS
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features h2,
body:has(.home-hero) .mki-workflow h2,
body:has(.home-hero) .mki-questions h2,
body:has(.home-hero) .mki-research h2,
body:has(.home-hero) .mki-roadmap h2,
body:has(.home-hero) .mki-contributor h2 {
  margin-top: 18px;
  margin-bottom: 0;

  max-width: 820px;

  font-size: clamp(
    2rem,
    3.4vw,
    3rem
  );

  line-height: 1.1;

  letter-spacing: -.035em;

  font-weight: 800;
}


/* ---------------------------------------------------------
   SECTION DESCRIPTION
   --------------------------------------------------------- */

body:has(.home-hero) .mki-section-intro {
  max-width: 680px;

  margin-top: 16px;
  margin-bottom: 0;

  color: var(--mki-muted);

  font-size: .92rem;

  line-height: 1.7;
}
/* =========================================================
   PART 2
   HERO
   ========================================================= */


/* ---------------------------------------------------------
   HERO
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero {
  position: relative;

  width: 100%;

  min-height: 560px;

  display: flex;

  align-items: center;

  overflow: hidden;

  box-sizing: border-box;

  background:
    linear-gradient(
      135deg,
      #284965 0%,
      #315775 55%,
      #416982 100%
    );
}


/* ---------------------------------------------------------
   HERO BACKGROUND IMAGE
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero img {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;

  z-index: 0;
}


/* ---------------------------------------------------------
   HERO IMAGE OVERLAY
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero::before {
  content: "";

  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(22, 47, 71, .76),
      rgba(35, 67, 93, .56),
      rgba(54, 88, 112, .40)
    );
}


/* ---------------------------------------------------------
   HERO LIGHT
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero::after {
  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  right: -130px;
  top: -170px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(121, 190, 255, .24),
      transparent 68%
    );

  z-index: 2;

  pointer-events: none;
}


/* ---------------------------------------------------------
   HERO CONTENT
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero > .hero-content {
  position: relative;

  z-index: 3;

  width: min(
    var(--mki-container),
    calc(100% - 48px)
  );

  max-width: var(--mki-container);

  margin-left: auto;
  margin-right: auto;

  padding-top: 76px;
  padding-bottom: 76px;

  box-sizing: border-box;

  text-align: center;
}


/* ---------------------------------------------------------
   HERO LABEL
   --------------------------------------------------------- */

body:has(.home-hero) .hero-label {
  display: inline-flex;

  align-items: center;

  padding: 7px 14px;

  border: 1px solid rgba(255,255,255,.25);

  border-radius: 999px;

  background: rgba(255,255,255,.09);

  color: #e4f1ff;

  font-size: .66rem;

  font-weight: 800;

  letter-spacing: .14em;

  text-transform: uppercase;
}


/* ---------------------------------------------------------
   HERO TITLE
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero h1 {
  max-width: 900px;

  margin: 23px auto 0;

  color: #ffffff;

  font-size: clamp(
    2.8rem,
    5vw,
    4.4rem
  );

  line-height: 1.04;

  letter-spacing: -.05em;

  font-weight: 800;
}


/* ---------------------------------------------------------
   HERO TITLE ACCENT
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero h1::after {
  content: "";

  display: block;

  width: 42px;

  height: 3px;

  margin: 21px auto 0;

  border-radius: 999px;

  background: #73b3ff;
}


/* ---------------------------------------------------------
   HERO DESCRIPTION
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero p {
  max-width: 680px;

  margin: 20px auto 0;

  color: #d9e7f5;

  font-size: .96rem;

  line-height: 1.7;
}


/* ---------------------------------------------------------
   HERO BUTTONS
   --------------------------------------------------------- */

body:has(.home-hero) .hero-actions {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 10px;

  margin-top: 27px;
}


body:has(.home-hero) .hero-actions a {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 43px;

  padding: 0 19px;

  border-radius: 8px;

  font-size: .82rem;

  font-weight: 700;

  text-decoration: none;
}


body:has(.home-hero) .hero-actions a:first-child {
  background: var(--mki-blue);

  color: #ffffff;

  box-shadow:
    0 8px 20px rgba(20, 74, 160, .25);
}


body:has(.home-hero) .hero-actions a:last-child {
  border: 1px solid rgba(255,255,255,.28);

  background: rgba(255,255,255,.08);

  color: #ffffff;
}
/* =========================================================
   PART 3
   FEATURES
   ========================================================= */

body:has(.home-hero) .mki-features {
  background:
    radial-gradient(
      circle at 85% 10%,
      rgba(111,171,235,.14),
      transparent 28%
    ),
    var(--mki-bg);
}


/* ---------------------------------------------------------
   FEATURE GRID
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-top: 42px;
}


/* ---------------------------------------------------------
   FEATURE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature {
  min-height: 190px;

  padding: 25px;

  box-sizing: border-box;

  border: 1px solid var(--mki-border);

  border-radius: 14px;

  background: rgba(255,255,255,.82);

  box-shadow:
    0 8px 25px rgba(38,69,104,.045);

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


body:has(.home-hero) .mki-feature:hover {
  transform: translateY(-3px);

  box-shadow:
    0 14px 30px rgba(38,69,104,.09);
}


/* ---------------------------------------------------------
   FEATURE ICON
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature-icon {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 31px;
  height: 31px;

  margin-bottom: 18px;

  border: 1px solid #c8ddf4;

  border-radius: 8px;

  background: #edf5ff;

  color: var(--mki-blue);

  font-size: .7rem;
}


/* ---------------------------------------------------------
   FEATURE TITLE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature h3 {
  margin: 0;

  color: var(--mki-text);

  font-size: 1.05rem;

  line-height: 1.3;
}


/* ---------------------------------------------------------
   FEATURE TEXT
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature p {
  margin-top: 9px;

  color: var(--mki-muted);

  font-size: .82rem;

  line-height: 1.65;
}


/* ---------------------------------------------------------
   FEATURE TOOLS
   --------------------------------------------------------- */

body:has(.home-hero) .mki-feature-tools {
  margin-top: 14px;

  color: var(--mki-blue);

  font-size: .61rem;

  font-weight: 800;

  letter-spacing: .06em;
}
/* =========================================================
   PART 4
   WORKFLOW
   ========================================================= */

body:has(.home-hero) .mki-workflow {
  background:
    linear-gradient(
      135deg,
      #243f5d,
      #2b4c6a
    );

  color: #ffffff;
}


body:has(.home-hero) .mki-workflow h2 {
  color: #ffffff;
}


body:has(.home-hero) .mki-workflow .mki-section-intro {
  color: #c0d0e0;
}


/* ---------------------------------------------------------
   WORKFLOW PATH
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-path {
  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 12px;

  margin-top: 42px;
}


/* ---------------------------------------------------------
   WORKFLOW STEP
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-step {
  min-height: 180px;

  padding: 21px;

  border: 1px solid rgba(194,219,242,.15);

  border-radius: 13px;

  background: rgba(255,255,255,.055);

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   NUMBER
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-number {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 27px;
  height: 27px;

  margin-bottom: 18px;

  border: 1px solid rgba(104,173,255,.45);

  border-radius: 50%;

  color: #70b0ff;

  font-size: .62rem;

  font-weight: 800;
}


/* ---------------------------------------------------------
   STEP TITLE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-step h3 {
  margin: 0;

  color: #ffffff;

  font-size: .94rem;

  line-height: 1.3;
}


/* ---------------------------------------------------------
   STEP DESCRIPTION
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-step p {
  margin-top: 9px;

  color: #b6c8da;

  font-size: .76rem;

  line-height: 1.6;
}


/* ---------------------------------------------------------
   CONNECTOR
   --------------------------------------------------------- */

body:has(.home-hero) .mki-workflow-connector {
  display: none;
}
/* =========================================================
   PART 5
   RESEARCH CASES
   ========================================================= */

body:has(.home-hero) .mki-research {
  background:
    linear-gradient(
      135deg,
      #1b3049,
      #213d5a
    );

  color: #ffffff;
}


body:has(.home-hero) .mki-research h2 {
  color: #ffffff;
}


body:has(.home-hero) .mki-research .mki-section-intro {
  color: #c0d0e0;
}


/* ---------------------------------------------------------
   RESEARCH LIST
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-list {
  display: grid;

  gap: 15px;

  margin-top: 43px;
}


/* ---------------------------------------------------------
   RESEARCH CARD
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-case {
  display: grid;

  grid-template-columns:
    55px minmax(0, 1fr);

  min-height: 200px;

  overflow: hidden;

  border: 1px solid rgba(191,218,241,.14);

  border-radius: 14px;

  background: rgba(255,255,255,.045);
}


/* ---------------------------------------------------------
   CASE WITH IMAGE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-case-image {
  grid-template-columns:
    55px minmax(0, 1fr) 330px;
}


/* ---------------------------------------------------------
   NUMBER
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-number {
  padding-top: 25px;

  text-align: center;

  color: #657b94;

  font-size: 1.7rem;

  font-weight: 800;

  line-height: 1;
}


/* ---------------------------------------------------------
   CONTENT
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-content {
  padding: 25px 26px;
}


body:has(.home-hero) .mki-research-tag {
  color: #69adff;

  font-size: .61rem;

  font-weight: 800;

  letter-spacing: .12em;
}


body:has(.home-hero) .mki-research-content h3 {
  margin-top: 10px;

  color: #ffffff;

  font-size: 1.12rem;

  line-height: 1.3;
}


body:has(.home-hero) .mki-research-content p {
  max-width: 610px;

  margin-top: 9px;

  color: #b8c9da;

  font-size: .82rem;

  line-height: 1.65;
}


body:has(.home-hero) .mki-research-tools {
  margin-top: 14px;

  color: #6bb0ff;

  font-size: .59rem;

  font-weight: 800;

  letter-spacing: .05em;
}


/* ---------------------------------------------------------
   GRAPHENE IMAGE
   --------------------------------------------------------- */

body:has(.home-hero) .mki-research-visual {
  min-height: 200px;

  padding: 18px 18px 18px 0;

  box-sizing: border-box;
}


body:has(.home-hero) .mki-research-visual img {
  display: block;

  width: 100%;
  height: 100%;

  min-height: 164px;

  object-fit: cover;

  object-position: center;

  border-radius: 10px;
}
/* =========================================================
   PART 6
   LEARNING ROADMAP
   ========================================================= */

body:has(.home-hero) .mki-roadmap {
  background:
    linear-gradient(
      135deg,
      #203951,
      #274967
    );

  color: #ffffff;
}


body:has(.home-hero) .mki-roadmap h2 {
  color: #ffffff;
}


body:has(.home-hero) .mki-roadmap .mki-section-intro {
  color: #c0d0e0;
}


body:has(.home-hero) .mki-roadmap-list {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;

  margin-top: 43px;
}


body:has(.home-hero) .mki-roadmap-item {
  min-height: 175px;

  padding: 23px;

  border: 1px solid rgba(191,218,241,.14);

  border-radius: 13px;

  background: rgba(255,255,255,.045);

  box-sizing: border-box;
}


body:has(.home-hero) .mki-roadmap-number {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 28px;
  height: 28px;

  border: 1px solid rgba(105,174,255,.42);

  border-radius: 50%;

  color: #6db0ff;

  font-size: .62rem;

  font-weight: 800;
}


body:has(.home-hero) .mki-roadmap-content {
  margin-top: 17px;
}


body:has(.home-hero) .mki-roadmap-content h3 {
  margin: 0;

  color: #ffffff;

  font-size: .96rem;
}


body:has(.home-hero) .mki-roadmap-content p {
  margin-top: 9px;

  color: #b7c8da;

  font-size: .77rem;

  line-height: 1.6;
}


body:has(.home-hero) .mki-roadmap-line {
  display: none;
}
/* =========================================================
   PART 7
   CONTRIBUTOR / WORKSHOP IDENTITY
   ========================================================= */

body:has(.home-hero) .mki-contributor {
  background:
    radial-gradient(
      circle at 85% 15%,
      rgba(111,171,235,.13),
      transparent 30%
    ),
    #edf3fa;
}


body:has(.home-hero) .mki-contributor-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 15px;

  margin-top: 43px;
}


body:has(.home-hero) .mki-contributor-person,
body:has(.home-hero) .mki-contributor-research {
  min-height: 190px;

  padding: 25px;

  border: 1px solid var(--mki-border);

  border-radius: 14px;

  background: rgba(255,255,255,.75);

  box-sizing: border-box;
}


body:has(.home-hero) .mki-contributor-role {
  color: var(--mki-blue);

  font-size: .62rem;

  font-weight: 800;

  letter-spacing: .12em;
}


body:has(.home-hero) .mki-contributor-person h3,
body:has(.home-hero) .mki-contributor-research h3 {
  margin-top: 11px;

  color: var(--mki-text);

  font-size: 1.1rem;
}


body:has(.home-hero) .mki-contributor-focus {
  margin-top: 10px;

  color: var(--mki-muted);

  font-size: .82rem;

  line-height: 1.65;
}
