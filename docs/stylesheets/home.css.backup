/* =========================================================
   16. ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  body:has(.home-hero) *,
  body:has(.home-hero) *::before,
  body:has(.home-hero) *::after {

    scroll-behavior: auto !important;

    transition: none !important;

    animation: none !important;

  }

}
/* =========================================================
   MKI HOME
   FINAL LAYOUT RESET
   REMOVE MATERIAL DOCUMENTATION CONSTRAINTS
   ========================================================= */


/* ---------------------------------------------------------
   HOME MUST USE THE FULL VIEWPORT
   --------------------------------------------------------- */

body:has(.home-hero) .md-main {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

body:has(.home-hero) .md-main__inner {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ---------------------------------------------------------
   REMOVE MATERIAL PRIMARY SIDEBAR FROM HOME
   --------------------------------------------------------- */

body:has(.home-hero) .md-sidebar--primary {
  display: none !important;
}


/* ---------------------------------------------------------
   REMOVE SECONDARY SIDEBAR / TOC FROM HOME
   --------------------------------------------------------- */

body:has(.home-hero) .md-sidebar--secondary {
  display: none !important;
}


/* ---------------------------------------------------------
   CONTENT MUST FILL THE SCREEN
   --------------------------------------------------------- */

body:has(.home-hero) .md-content {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ---------------------------------------------------------
   CONTENT INNER
   --------------------------------------------------------- */

body:has(.home-hero) .md-content__inner {
  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ---------------------------------------------------------
   REMOVE MARKDOWN TYPESET CONSTRAINT
   --------------------------------------------------------- */

body:has(.home-hero) .md-content > .md-typeset {
  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ---------------------------------------------------------
   HIDE HOME BREADCRUMBS
   --------------------------------------------------------- */

body:has(.home-hero) .md-path {
  display: none !important;
}

body:has(.home-hero) .md-breadcrumbs {
  display: none !important;
}


/* ---------------------------------------------------------
   HOME HERO FULL WIDTH
   --------------------------------------------------------- */

body:has(.home-hero) .home-hero {
  width: 100vw !important;
  max-width: none !important;

  margin: 0 !important;

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   ALL HOME SECTIONS FULL WIDTH
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features,
body:has(.home-hero) .mki-workflow,
body:has(.home-hero) .mki-questions,
body:has(.home-hero) .mki-research,
body:has(.home-hero) .mki-roadmap,
body:has(.home-hero) .mki-contributor {
  width: 100% !important;
  max-width: none !important;

  margin-left: 0 !important;
  margin-right: 0 !important;
}


/* ---------------------------------------------------------
   SECTION INNER CONTENT
   --------------------------------------------------------- */

body:has(.home-hero) .mki-features-inner,
body:has(.home-hero) .mki-workflow-inner,
body:has(.home-hero) .mki-questions-inner,
body:has(.home-hero) .mki-research-inner,
body:has(.home-hero) .mki-roadmap-inner,
body:has(.home-hero) .mki-contributor-inner {

  width:
    min(1180px, calc(100% - 64px)) !important;

  max-width: 1180px !important;

  margin-left: auto !important;
  margin-right: auto !important;

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   MATERIAL TABS
   KEEP TEXT VISIBLE
   --------------------------------------------------------- */

body:has(.home-hero) .md-tabs__link {
  white-space: nowrap !important;
  overflow: visible !important;

  opacity: 1 !important;
}


/* ---------------------------------------------------------
   TABS CONTAINER
   --------------------------------------------------------- */

body:has(.home-hero) .md-tabs__list {
  width: auto !important;
}


/* ---------------------------------------------------------
   PREVENT HOME FROM INHERITING DOCUMENT WIDTH
   --------------------------------------------------------- */

body:has(.home-hero) .md-grid {
  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media screen and (max-width: 700px) {

  body:has(.home-hero)
  .mki-features-inner,
  body:has(.home-hero)
  .mki-workflow-inner,
  body:has(.home-hero)
  .mki-questions-inner,
  body:has(.home-hero)
  .mki-research-inner,
  body:has(.home-hero)
  .mki-roadmap-inner,
  body:has(.home-hero)
  .mki-contributor-inner {

    width:
      calc(100% - 32px) !important;

    max-width: none !important;
  }

}
.mki-contributor
.mki-contributor-inner
.mki-contributor-grid
.mki-contributor-person
.mki-contributor-research
.mki-contributor-focus
/* =========================================================
   MKI × ITB × BRIN
   Workshop Collaboration
   ========================================================= */

.mki-partner {
  width: 100%;
  margin: 0;
  padding: 72px 0;
  box-sizing: border-box;

  background: #eef5fc;
}

.mki-partner-inner {
  width: min(1120px, calc(100% - 64px));
  margin: 0 auto;

  display: grid;
  grid-template-columns: 360px minmax(0, 1fr);
  align-items: center;

  gap: 72px;

  box-sizing: border-box;
}


/* ---------------------------------------------------------
   BRAND AREA
   --------------------------------------------------------- */

.mki-partner-brand {
  display: flex;
  align-items: center;
  justify-content: center;

  min-width: 0;
}

.mki-partner-logo {
  width: 118px;
  height: 118px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex: 0 0 118px;

  overflow: hidden;

  background: #ffffff;
  border: 1px solid #dbe7f3;
  border-radius: 18px;

  box-shadow:
    0 12px 30px rgba(24, 55, 88, .08);
}

.mki-partner-logo img {
  display: block;

  width: 100%;
  height: 100%;

  max-width: none;

  object-fit: contain;
}


/* ---------------------------------------------------------
   MULTIPLICATION SYMBOL
   --------------------------------------------------------- */

.mki-partner-symbol {
  margin: 0 20px;

  color: #7a91aa;

  font-size: 1.4rem;
  font-weight: 500;
}


/* ---------------------------------------------------------
   ITB × BRIN
   --------------------------------------------------------- */

.mki-partner-institutions {
  display: flex;
  align-items: center;
  gap: 9px;

  white-space: nowrap;

  color: #173253;
}

.mki-partner-institutions strong {
  font-size: 1.15rem;
  font-weight: 750;
  letter-spacing: -.02em;
}

.mki-partner-institutions span {
  color: #8aa0b8;
  font-size: 1rem;
}


/* ---------------------------------------------------------
   CONTENT
   --------------------------------------------------------- */

.mki-partner-content {
  min-width: 0;
}

.mki-partner-eyebrow {
  display: inline-flex;
  align-items: center;

  margin-bottom: 14px;

  color: #2d78d4;

  font-size: .68rem;
  font-weight: 800;
  letter-spacing: .14em;
  line-height: 1.2;
}

.mki-partner-content h3 {
  margin: 0;

  color: #142d4d;

  font-size: clamp(1.8rem, 3vw, 2.7rem);
  line-height: 1.1;
  letter-spacing: -.035em;
  font-weight: 800;
}

.mki-partner-content p {
  max-width: 680px;

  margin: 16px 0 0;

  color: #5d7188;

  font-size: .98rem;
  line-height: 1.7;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .mki-partner {
    padding: 56px 0;
  }

  .mki-partner-inner {
    width: min(720px, calc(100% - 48px));

    grid-template-columns: 1fr;

    gap: 32px;

    text-align: center;
  }

  .mki-partner-brand {
    justify-content: center;
  }

  .mki-partner-content p {
    margin-left: auto;
    margin-right: auto;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .mki-partner {
    padding: 48px 0;
  }

  .mki-partner-inner {
    width: calc(100% - 36px);
  }

  .mki-partner-logo {
    width: 88px;
    height: 88px;
    flex-basis: 88px;

    border-radius: 14px;
  }

  .mki-partner-symbol {
    margin: 0 12px;
  }

  .mki-partner-institutions strong {
    font-size: 1rem;
  }

  .mki-partner-content h3 {
    font-size: 1.8rem;
  }

  .mki-partner-content p {
    font-size: .9rem;
    line-height: 1.65;
  }

}
/* =========================================================
   MKI FOOTER
   ========================================================= */

.mki-footer {
  width: 100%;
  margin: 0;
  padding: 48px 0 28px;

  box-sizing: border-box;

  background: #172f4d;
  color: #ffffff;
}

.mki-footer-inner {
  width: min(1120px, calc(100% - 64px));
  margin: 0 auto;

  box-sizing: border-box;
}


/* =========================================================
   MAIN FOOTER ROW
   ========================================================= */

.mki-footer-main {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 48px;

  padding-bottom: 34px;

  border-bottom: 1px solid rgba(255, 255, 255, .12);
}


/* =========================================================
   BRAND
   ========================================================= */

.mki-footer-brand {
  display: flex;
  align-items: center;

  min-width: 0;

  gap: 16px;
}

.mki-footer-logo {
  width: 58px;
  height: 58px;

  flex: 0 0 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background: #ffffff;
  border-radius: 10px;
}

.mki-footer-logo img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;
}

.mki-footer-brand-text {
  min-width: 0;
}

.mki-footer-brand-text h3 {
  margin: 0;

  color: #ffffff;

  font-size: 1.05rem;
  line-height: 1.25;
  font-weight: 750;
  letter-spacing: -.02em;
}

.mki-footer-brand-text p {
  max-width: 440px;

  margin: 6px 0 0;

  color: #b9c9da;

  font-size: .82rem;
  line-height: 1.55;
}


/* =========================================================
   LINKS
   ========================================================= */

.mki-footer-links {
  display: flex;
  align-items: center;
  justify-content: flex-end;

  gap: 26px;

  flex-wrap: wrap;
}

.mki-footer-links a {
  color: #c8d5e3 !important;

  font-size: .8rem;
  font-weight: 600;

  text-decoration: none !important;

  transition:
    color .2s ease,
    transform .2s ease;
}

.mki-footer-links a:hover {
  color: #ffffff !important;
  transform: translateY(-1px);
}


/* =========================================================
   BOTTOM
   ========================================================= */

.mki-footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding-top: 22px;

  color: #8fa5bb;

  font-size: .7rem;
  line-height: 1.5;

  letter-spacing: .01em;
}

.mki-footer-bottom > span:first-child {
  color: #b9c9da;
  font-weight: 700;
}

.mki-footer-separator {
  opacity: .45;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 800px) {

  .mki-footer {
    padding: 40px 0 24px;
  }

  .mki-footer-inner {
    width: min(680px, calc(100% - 48px));
  }

  .mki-footer-main {
    align-items: flex-start;

    flex-direction: column;

    gap: 28px;
  }

  .mki-footer-links {
    justify-content: flex-start;

    gap: 18px;
  }

  .mki-footer-bottom {
    align-items: flex-start;

    flex-direction: column;

    gap: 5px;
  }

  .mki-footer-separator {
    display: none;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .mki-footer {
    padding: 36px 0 22px;
  }

  .mki-footer-inner {
    width: calc(100% - 36px);
  }

  .mki-footer-brand {
    gap: 13px;
  }

  .mki-footer-logo {
    width: 48px;
    height: 48px;

    flex-basis: 48px;

    border-radius: 8px;
  }

  .mki-footer-brand-text h3 {
    font-size: .95rem;
  }

  .mki-footer-brand-text p {
    font-size: .75rem;
  }

  .mki-footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;

    width: 100%;

    gap: 12px 20px;
  }

  .mki-footer-links a {
    font-size: .76rem;
  }

  .mki-footer-bottom {
    font-size: .66rem;
  }

}
/* =========================================================
   MKI WORKSHOP
   HERO IMAGE + PARALLAX
   ========================================================= */

.home-hero {
  position: relative;
  width: 100%;
  min-height: 720px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
  box-sizing: border-box;

  background: #294b6b;

  isolation: isolate;
}


/* =========================================================
   HERO IMAGE
   ========================================================= */

.home-hero-media {
  position: absolute;
  inset: -10% 0;

  z-index: 0;

  overflow: hidden;

  pointer-events: none;
}


.home-hero-media img {
  position: absolute;

  width: 100%;
  height: 120%;

  left: 0;
  top: -10%;

  display: block;

  object-fit: cover;
  object-position: center center;

transform:
  translate3d(
    0,
    var(--hero-parallax-y, 0px),
    0
  )
  scale(1.04) !important;
  will-change: transform;

  user-select: none;
  -webkit-user-drag: none;
}


/* =========================================================
   HERO OVERLAY
   ========================================================= */

.home-hero-overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  pointer-events: none;

  background:
    linear-gradient(
      180deg,
      rgba(20, 47, 73, .18) 0%,
      rgba(20, 47, 73, .08) 45%,
      rgba(13, 35, 57, .38) 100%
    );
}


/* =========================================================
   SOFT LIGHT
   ========================================================= */

.home-hero-overlay::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 50% 42%,
      rgba(255, 255, 255, .12),
      transparent 46%
    );

  pointer-events: none;
}


/* =========================================================
   CONTENT
   ========================================================= */

.home-hero > .hero-content {
  position: relative;

  z-index: 3;

  width: min(1180px, calc(100% - 64px));
  max-width: 1180px;

  margin-left: auto !important;
  margin-right: auto !important;

  padding-top: 110px;
  padding-bottom: 110px;

  box-sizing: border-box;

  text-align: center;
}


/* =========================================================
   LABEL
   ========================================================= */

.home-hero .hero-label {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 8px 16px;

  border: 1px solid rgba(255, 255, 255, .34);
  border-radius: 999px;

  background: rgba(255, 255, 255, .11);

  color: #ffffff;

  font-size: .70rem;
  font-weight: 800;

  letter-spacing: .15em;

  text-transform: uppercase;

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}


/* =========================================================
   TITLE
   ========================================================= */

.home-hero h1 {
  width: 100%;
  max-width: 1000px;

  margin: 26px auto 0;

  color: #ffffff;

  font-size: clamp(3rem, 6vw, 5.5rem);

  line-height: 1.02;

  letter-spacing: -.055em;

  font-weight: 800;

  text-shadow:
    0 2px 12px rgba(0, 0, 0, .18);
}


/* =========================================================
   ACCENT LINE
   ========================================================= */

.home-hero h1::after {
  content: "";

  display: block;

  width: 46px;
  height: 3px;

  margin: 28px auto 0;

  border-radius: 99px;

  background: #75b9ff;

  box-shadow:
    0 0 14px rgba(117, 185, 255, .35);
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.home-hero p {
  width: 100%;
  max-width: 760px;

  margin: 26px auto 0;

  color: rgba(255, 255, 255, .90);

  font-size: 1.02rem;

  line-height: 1.72;

  text-shadow:
    0 1px 7px rgba(0, 0, 0, .20);
}


/* =========================================================
   ACTIONS
   ========================================================= */

.home-hero .hero-actions {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 12px;

  margin-top: 32px;

  flex-wrap: wrap;
}


.home-hero .hero-actions a {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 44px;

  padding: 0 20px;

  border-radius: 8px;

  font-size: .88rem;
  font-weight: 700;

  text-decoration: none;

  transition:
    transform .2s ease,
    background .2s ease;
}


.home-hero .hero-actions a:first-child {
  color: #ffffff;

  background: #2878e8;

  border: 1px solid #2878e8;

  box-shadow:
    0 8px 24px rgba(20, 80, 170, .28);
}


.home-hero .hero-actions a:last-child {
  color: #ffffff;

  background: rgba(255, 255, 255, .10);

  border: 1px solid rgba(255, 255, 255, .34);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}


.home-hero .hero-actions a:hover {
  transform: translateY(-2px);
}


.home-hero .hero-actions a:first-child:hover {
  background: #3986ed;
}


.home-hero .hero-actions a:last-child:hover {
  background: rgba(255, 255, 255, .18);
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .home-hero {
    min-height: 650px;
  }

  .home-hero > .hero-content {
    width: calc(100% - 48px);

    padding-top: 90px;
    padding-bottom: 90px;
  }

  .home-hero h1 {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .home-hero {
    min-height: 620px;
  }

  .home-hero > .hero-content {
    width: calc(100% - 32px);

    padding-top: 80px;
    padding-bottom: 80px;
  }

  .home-hero h1 {
    font-size: clamp(2.35rem, 11vw, 3.5rem);
  }

  .home-hero p {
    font-size: .92rem;
  }

  .home-hero .hero-actions a {
    width: 100%;
    max-width: 240px;
  }

}
.home-hero
.home-hero::before
.home-hero > .hero-content
.home-hero h1
.home-hero p
.hero-label
.hero-actions
/* =========================================================
   FINAL HOME HERO OVERRIDE
   ========================================================= */

body:has(.home-hero) .md-main__inner,
body:has(.home-hero) .md-content,
body:has(.home-hero) .md-content__inner,
body:has(.home-hero) .md-content > .md-typeset {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}


body:has(.home-hero) .md-main {
  background: #eef4fb !important;
}


.home-hero {
  position: relative !important;

  width: 100% !important;
  max-width: none !important;

  min-height: 720px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  background: #294b6b !important;

  isolation: isolate !important;
}


.home-hero-media {
  position: absolute !important;

  inset: -10% 0 !important;

  width: 100% !important;
  height: 120% !important;

  z-index: 0 !important;

  overflow: hidden !important;

  pointer-events: none !important;
}


.home-hero-media img {
  position: absolute !important;

  width: 100% !important;
  height: 120% !important;

  max-width: none !important;

  left: 0 !important;
  top: -10% !important;

  object-fit: cover !important;
  object-position: center center !important;

  display: block !important;

  will-change: transform;
}


.home-hero-overlay {
  position: absolute !important;

  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  z-index: 1 !important;

  background:
    linear-gradient(
      180deg,
      rgba(20, 47, 73, .16) 0%,
      rgba(20, 47, 73, .08) 45%,
      rgba(13, 35, 57, .36) 100%
    ) !important;

  pointer-events: none !important;
}


.home-hero > .hero-content {
  position: relative !important;

  z-index: 3 !important;

  width: min(1180px, calc(100% - 64px)) !important;
  max-width: 1180px !important;

  margin: 0 auto !important;

  padding: 110px 0 !important;

  box-sizing: border-box !important;

  text-align: center !important;
}


.home-hero h1 {
  width: 100% !important;

  max-width: 1000px !important;

  margin: 26px auto 0 !important;

  color: #ffffff !important;

  font-size: clamp(3rem, 6vw, 5.5rem) !important;

  line-height: 1.02 !important;

  letter-spacing: -.055em !important;

  font-weight: 800 !important;

