  left: 0 !important;
  top: -8% !important;

  width: 100% !important;
  height: 116% !important;

  max-width: none !important;

  display: block !important;

  object-fit: cover !important;
  object-position: center center !important;

  transform:
    translate3d(0, 0, 0)
    scale(1.06) !important;

  will-change: transform;

  transition: none !important;
}
