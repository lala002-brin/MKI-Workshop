  transform:
    translate3d(
      0,
      var(--hero-parallax-y, 0px),
      0
    )
    scale(1.04) !important;

  will-change: transform;
}
/* =========================================================
   HERO PARALLAX IMAGE
   ========================================================= */

.home-hero-media {
  position: absolute !important;

  inset: -12% 0 !important;

  width: 100% !important;
